---
import ProyectCarrusel from "./ProjectCarrusel.astro";
import { projects } from "../../data/projects";
---

<section class="project-section" id="projects">
  <div class="section-header">
    <span class="section-tag">PROJECTS</span>
    <h2 class="section-title">
      Collection of projects I have worked on throughout my academic and
      professional career.
    </h2>
    <p class="section-description">
      These projects represent my growth as a software engineer and my
      commitment to delivering high-quality solutions.
    </p>
  </div>

  <ProyectCarrusel projects={projects} />
</section>

<style>
  .project-section {
    position: relative;
    margin: 10vh 20vh;
    padding: 4rem 2rem 2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(10px);
  }

  .section-header {
    position: absolute;
    top: -1.5rem;
    left: 2rem;
    padding: 0 1rem;
    background: transparent;
    max-width: 900px;
  }

  .section-tag {
    display: block;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .section-description {
    max-width: 65ch;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .project-section :global(.project-carousel) {
    margin: 7rem 0 1rem 0;
  }

  @media (max-width: 1024px) {
    .project-section {
      margin: 6rem 2rem;
    }
  }

  @media (max-width: 768px) {
    .project-section {
      margin: 4rem 1rem;
      padding: 3rem 1.5rem 1.5rem;
    }

    .section-header {
      left: 1.5rem;
    }

    .section-tag {
      font-size: 0.75rem;
    }
  }
</style>
