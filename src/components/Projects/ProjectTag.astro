---
import { Icon } from "astro-icon/components";

const { id, name, icon, color } = Astro.props;
---

<div class="tech-badge" id={id} style={`--tech-color:${color};`}>
  <Icon name={icon} class="tech-badge-icon" />
  <span>{name}</span>
</div>

<style>
  .tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    padding: 0.45rem 0.75rem;

    border-radius: 999px;

    border: 1px solid color-mix(in srgb, var(--tech-color) 35%, transparent);

    background: color-mix(in srgb, var(--tech-color) 10%, transparent);

    color: var(--color-text);

    font-size: 0.8rem;
    font-weight: 500;

    white-space: nowrap;

    backdrop-filter: blur(10px);
  }

  .tech-badge-icon {
    font-size: 1rem;

    color: var(--tech-color);

    flex-shrink: 0;
  }

  .tech-badge span {
    line-height: 1;
  }
</style>
