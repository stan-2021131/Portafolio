---
import type { Project } from "../../types/proyecto";
import { technologies } from "../../data/tecnologias";
import ProjectTag from "./ProjectTag.astro";

const {
  id = "",
  title = "",
  description = "",
  image = "",
  keyContribution = "",
  github = "",
  demo = "",
  technologiesUsed = [],
} = Astro.props as Project;

const techMap = Object.fromEntries(technologies.map((tech) => [tech.id, tech]));

const projectTechnologies = technologiesUsed
  .map((id) => techMap[id])
  .filter((tech): tech is (typeof technologies)[number] => Boolean(tech));
---

<div class="card">
  <div class="image-container">
    <img src={image} alt={title} class="cardimage" />
  </div>
  <div class="card-content">
    <h2 class="card-title">{title}</h2>
    <p class="card-description">{description}</p>

    <div class="card-contribution">
      <span class="card-contribution-title">Key Contribution</span>
      <p class="card-contribution-description">{keyContribution}</p>
    </div>

    <div class="card-tags">
      {
        projectTechnologies.map((tech) => (
          <ProjectTag
            id={tech.id}
            name={tech.name}
            icon={tech.icon}
            description={tech.description}
            color={tech.color}
          />
        ))
      }
    </div>
    <div class="card-buttons">
      {
        demo != "" && (
          <a href={demo} class="btn-primary">
            See Demo
          </a>
        )
      }
      <a href={github} class="btn-secondary">See in GitHub</a>
    </div>
  </div>
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 2rem;

    padding: 1.5rem;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;

    background: rgba(255, 255, 255, 0.02);

    backdrop-filter: blur(10px);

    overflow: hidden;

    transition:
      transform var(--transition-normal),
      border-color var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .card:hover {
    transform: translateY(-6px);

    border-color: rgba(212, 165, 199, 0.25);

    box-shadow:
      0 0 0 1px rgba(212, 165, 199, 0.1),
      0 20px 40px rgba(0, 0, 0, 0.35);
  }
  .image-container {
    flex-shrink: 0;
    width: 100%;
    height: 180px;

    border-radius: 18px;

    overflow: hidden;

    background: rgba(255, 255, 255, 0.04);
  }

  .cardimage {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 0.6s ease;
  }

  .card:hover .cardimage {
    transform: scale(1.04);
  }

  .card-content {
    flex: 1;

    display: flex;
    flex-direction: column;

    min-width: 0;
  }

  .card-title {
    margin-bottom: 0.75rem;

    font-size: 1.25rem;
    font-weight: 700;

    line-height: 1.1;
  }

  .card-description {
    margin-bottom: 1.5rem;

    color: var(--color-text-muted);

    line-height: 1.4;
  }

  .card-contribution {
    margin-bottom: 1.5rem;

    padding-left: 1rem;

    border-left: 2px solid rgba(212, 165, 199, 0.3);
  }

  .card-contribution-title {
    display: block;

    margin-bottom: 0.5rem;

    color: var(--color-accent);

    font-size: 0.9rem;
    font-weight: 700;

    letter-spacing: 0.12em;

    text-transform: uppercase;
  }

  .card-contribution-description {
    color: var(--color-text-muted);

    line-height: 1.4;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;

    gap: 0.5rem;

    margin-top: auto;
  }

  .card-buttons {
    display: flex;
    flex-wrap: wrap;

    gap: 0.75rem;

    margin-top: 1.5rem;
  }

  @media (max-width: 900px) {
    .image-container {
      width: 100%;
      height: 220px;
    }
  }
</style>
