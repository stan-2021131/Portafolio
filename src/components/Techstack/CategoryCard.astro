---
import TechnologyTag from "./TechnologyTag.astro";
import type { Technology, Category } from "../../types/tecnologia";

const { category, technologies } = Astro.props as {
  category: Category;
  technologies: Technology[];
};

const calculateHeight = technologies.length * 40 + 120;
---

<div class="category-card" id={category}>
  <h2 class="category-title">{category}</h2>
  <div class="category-content" style={`height:${calculateHeight}px;`}>
    {
      technologies.map((technology) => (
        <TechnologyTag
          {...technology}
          style={`left:${technology.position.x}%;top:${technology.position.y}%;`}
        />
      ))
    }
  </div>
</div>

<style>
  .category-card {
    position: relative;
    z-index: 1;
    height: fit-content;

    margin: 0vh 2vh;

    padding: 2rem;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;

    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(10px);

    overflow: visible;
  }

  .category-content {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }
</style>
