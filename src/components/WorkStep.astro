---
import { Icon } from "astro-icon/components";

const { icon, title } = Astro.props;
---

<div class="work-step">
  <div class="step-icon">
    <Icon name={icon} />
  </div>

  <p>{title}</p>
</div>

<style>
  .work-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;

    padding: 1.5rem;

    text-align: center;

    border-radius: var(--radius-md);

    transition:
      transform var(--transition-fast),
      background-color var(--transition-fast);
  }

  .step-icon {
    width: 3.5rem;
    height: 3.5rem;

    display: grid;
    place-items: center;

    transition: color var(--transition-fast);
  }

  .step-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .work-step:hover {
    transform: translateY(-8px);
    background: var(--color-surface);
  }

  .work-step:hover .step-icon {
    color: var(--color-accent);
  }
</style>
