---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Sergio Tan | Backend-Focused Full Stack Developer</title>

    <meta
      name="description"
      content="Backend-focused Full Stack Developer specializing in APIs, backend systems, software architecture, and modern web technologies."
    />

    <meta property="og:title" content="Sergio Tan Portfolio" />

    <meta
      property="og:description"
      content="Backend-focused Full Stack Developer"
    />

    <meta
      property="og:image"
      content="https://portafolio.sergiotan.online/preview.png"
    />

    <meta property="og:url" content="https://portafolio.sergiotan.online" />

    <meta property="og:type" content="website" />

    <meta name="author" content="Sergio Tan" />

    <meta name="theme-color" content="#0f0f0f" />
  </head>
  <body>
    <Sidebar />
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    min-height: 100vh;

    display: flex;
    background-color: var(--color-bg);
  }

  main {
    flex: 1;
  }
</style>
